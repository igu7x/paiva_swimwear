#!/bin/sh
#
# Recusa qualquer commit cuja mensagem atribua autoria a uma IA.
#
# Motivo: um trailer "Co-Authored-By: Claude ..." faz o GitHub registrar o
# nome da IA na aba Contributors do repositório. Este projeto não quer isso.
#
# Para ativar numa máquina nova (o Git não instala hooks sozinho):
#
#     git config core.hooksPath .githooks
#
# Se precisar pular a checagem uma vez: git commit --no-verify

mensagem="$1"

# Ignora as linhas de comentário que o Git escreve no arquivo da mensagem.
conteudo=$(grep -v '^#' "$mensagem")

padrao='co-authored-by:.*(claude|anthropic|copilot|gpt|cursor|codex|gemini)|generated with .*(claude|anthropic|copilot|cursor)|🤖 generated with'

if printf '%s' "$conteudo" | grep -qiE "$padrao"; then
  echo ""
  echo "  COMMIT RECUSADO"
  echo ""
  echo "  A mensagem contém atribuição de autoria a uma IA. Linha encontrada:"
  echo ""
  printf '%s' "$conteudo" | grep -inE "$padrao" | sed 's/^/      /'
  echo ""
  echo "  Remova essa linha e faça o commit de novo."
  echo ""
  exit 1
fi

exit 0
