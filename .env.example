# ---------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores.
#
#     cp .env.example .env.local        (ou copie pelo Explorer do Windows)
#
# O .env.local NUNCA vai pro Git — ele está no .gitignore. Os mesmos valores
# precisam ser cadastrados também no painel da Vercel, em Settings > Environment
# Variables, senão o site publicado não sobe.
# ---------------------------------------------------------------------------

# Conexão com o banco Postgres do Supabase.
# Onde achar: painel do Supabase > botão "Connect" (no topo) > aba "Connection
# string" > escolha "Session pooler" > modo URI. Troque [YOUR-PASSWORD] pela
# senha do banco que você definiu ao criar o projeto.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Endereço público do seu projeto Supabase.
# Onde achar: Project Settings > Data API > "Project URL".
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Chave pública do Supabase — a que pode aparecer no navegador.
# Onde achar: Project Settings > API Keys > "anon public" (em projetos novos ela
# se chama "publishable key" e começa com sb_publishable_). Qualquer uma das
# duas serve; cole o valor aqui.
# Esta chave é pública de propósito: quem a tiver não consegue ler nada do banco,
# porque todas as tabelas estão com RLS ligado e sem nenhuma política de acesso.
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_aqui_a_chave_publica"
