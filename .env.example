# ---------------------------------------------------------------------------
# Modelo dos arquivos de ambiente. Copie para .env.local e preencha.
#
#     cp .env.example .env.local        (ou copie pelo Explorer do Windows)
#
# Nenhum arquivo .env vai pro Git — todos estão no .gitignore.
#
# SÃO DOIS AMBIENTES, e eles não se misturam:
#
#   .env.local            desenvolvimento — o Postgres da sua máquina.
#                         Usado por `npm run dev` e `npm run db:migrate`.
#
#   .env.producao.local   produção — o Supabase da loja de verdade.
#                         Usado SÓ por `npm run db:migrate:prod`.
#
#   Painel da Vercel      produção — o site publicado.
#                         Settings > Environment Variables, as três variáveis
#                         abaixo com os valores do Supabase.
#
# O banco é separado de propósito: sem isso, uma peça cadastrada em teste
# aparece na loja de verdade, e um pedido de teste vira pedido na tela dela.
# ---------------------------------------------------------------------------


# --- Banco de dados --------------------------------------------------------
#
# NO .env.local (desenvolvimento): o Postgres da sua máquina. Se você não tem
# Postgres instalado, baixe em postgresql.org. Depois rode `npm run db:criar`
# para criar o banco e `npm run db:migrate` para montar as tabelas.
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/paiva_dev"
#
# NO .env.producao.local: a conexão do Supabase. Onde achar: painel do Supabase
# > botão "Connect" (no topo) > "Connection string" > escolha SESSION POOLER >
# modo URI. Troque [YOUR-PASSWORD] pela senha do banco.
#
# Escolha o Session pooler, não "Direct connection": a conexão direta só atende
# por IPv6, e a Vercel não fala IPv6 com o banco sem um adicional pago. É um
# erro que só aparece depois de publicar.


# --- Supabase --------------------------------------------------------------
#
# Estas duas ficam iguais nos dois ambientes. Elas cuidam do LOGIN da
# vendedora, que não guarda catálogo nem pedido — por isso não precisam ser
# separadas.

# Endereço público do projeto.
# Onde achar: Project Settings > Data API > "Project URL".
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"

# Chave pública — a que pode aparecer no navegador.
# Onde achar: Project Settings > API Keys > "anon public" (em projetos novos ela
# se chama "publishable key" e começa com sb_publishable_).
#
# Esta chave é pública de propósito: quem a tiver não consegue ler nada do
# banco, porque todas as tabelas estão com RLS ligado e sem nenhuma política.
NEXT_PUBLIC_SUPABASE_ANON_KEY="cole_aqui_a_chave_publica"
